<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>eu.oh2gba.otd</id>
  <launchable type="desktop-id">@OTD_DESKTOP_ID@.desktop</launchable>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>otd</name>
  <developer id="eu.oh2gba"><name>John, OH2GBA</name></developer>
  <summary>Who is on the shortwave frequency you are tuned to</summary>
  <description>
    <p>otd (On The Dial) follows the VFO of your receiver through Hamlib's rigctld and shows which
       shortwave stations are scheduled on or near that frequency right now: broadcasters,
       utility stations, time signals and oddities such as The Buzzer.</p>
    <ul>
      <li>Live on-air status from the EiBi, HFCC and Aoki schedules, evaluated against UTC</li>
      <li>A radio-style dial scale and a list that keeps the tuned frequency in the middle</li>
      <li>Listen through public KiwiSDR receivers, following the same dial</li>
      <li>Follows the rig, or type a frequency; double-click a station to tune there</li>
      <li>Search the whole database by station, language, site or country, with exclusions</li>
      <li>Band indicator, optionally with Traficom's detailed allocation table (Finland)</li>
      <li>Mode column: AM, USB, LSB, CW, DRM, RTTY, FAX, HFDL</li>
      <li>Your own list of identifications, with import and export</li>
      <li>Can start rigctld for you; works with gqrx and SDR++ rigctl servers too</li>
    </ul>
  </description>
  <screenshots>
    <screenshot type="default">
      <caption>Stations on air near the tuned frequency</caption>
      <image>https://otd.oh2gba.eu/screenshot.png</image>
    </screenshot>
  </screenshots>
  <url type="homepage">https://otd.oh2gba.eu/</url>
  <url type="help">https://otd.oh2gba.eu/rig.html</url>
  <url type="bugtracker">https://github.com/oh2gba/otd/issues</url>
  <url type="vcs-browser">https://github.com/oh2gba/otd</url>
  <content_rating type="oars-1.1"/>
  <categories><category>HamRadio</category><category>Network</category></categories>
  <keywords><keyword>shortwave</keyword><keyword>SWL</keyword><keyword>rigctld</keyword><keyword>EiBi</keyword></keywords>
  <releases>
    <release version="1.6.5" date="2026-09-30">
      <description>
        <ul>
          <li>A first start opens on The Buzzer, 4625 kHz, with Follow rig off, On air only on, and a free public KiwiSDR receiver picked at random</li>
          <li>Shift+Down and Shift+Up tune to the next station down or up the list, with or without a rig; the mouse wheel over a digit of the big frequency tunes the rig too</li>
          <li>Stations in the aeronautical, maritime and amateur bands whose schedule gives no mode are shown as USB instead of AM</li>
          <li>KiwiSDR: opening the receiver's own web page while listening to it hands the connection to the browser, as most receivers take one connection per address</li>
          <li>Inside: the program's logic is separated from its window, with more tests</li>
        </ul>
      </description>
    </release>
    <release version="1.6.4" date="2026-09-28">
      <description>
        <ul>
          <li>Search finds languages, transmitter sites and target areas by name in every list, and target areas read as names: North Europe, or HFCC's zones as regions</li>
          <li>Search terms for one column: target:, language:, country:, site:, station:, mode:; search results sort by a click on a column title</li>
          <li>The imported lists are kept as published and read through lookup tables; the first start fetches them again</li>
          <li>KiwiSDR: sound on a Windows without Media Foundation, the proxy receivers play, receivers that limit programs accept otd, the reason for a stop is clearer, and a bar in the status bar shows the audio in hand</li>
          <li>KiwiSDR: a globe button opens the receiver's own web page; the out-of-range message clears when tuning back</li>
          <li>With Follow rig off, a double-click tunes otd and the online receiver, not the rig; the dial view loads more when scrolled to its end</li>
          <li>--log writes what the program does to a file, for looking into a problem</li>
        </ul>
      </description>
    </release>
    <release version="1.6.3" date="2026-09-28">
      <description>
        <ul>
          <li>Rig status: "Rig not answering" no longer appears while the rig sits on one frequency, and a switched-off radio behind a running rigctld counts as not answering</li>
          <li>KiwiSDR player: the reason a receiver stops is shown (busy, password, time limit, refused connection), switching receivers no longer stops the new one, and a receiver that never answers is given up after 30 seconds</li>
          <li>KiwiSDR player: the list keeps naming the receiver you hear while you search or the directory changes, own addresses may be plain host names, and data modes such as PKTUSB play as USB</li>
          <li>The receiver directory is fetched at most once a week, and only when the player is used</li>
          <li>OK in Settings keeps the volume and the Follow rig choice; the frequency field takes a decimal point or comma; the column menu opens once</li>
          <li>Search finds frequencies with decimals such as 13553.125</li>
        </ul>
      </description>
    </release>
    <release version="1.6.2" date="2026-09-27">
      <description>
        <ul>
          <li>KiwiSDR player: a plain receiver list with a search box, a star for favourites, a button to add your own address, and a mode box that is yours whenever no rig is followed</li>
          <li>Without a rig: the dial starts on the remembered frequency (49 m at first), the wheel over a digit of the big frequency turns that digit, and the mode is remembered</li>
          <li>Tuning sends the mode before the frequency, so radios with a mode offset land right</li>
          <li>Status bar: one steady line while the rig is not answering, the receiver's state beside it, no Traficom count</li>
          <li>A version check started from the menu reports its result</li>
        </ul>
      </description>
    </release>
    <release version="1.6.1" date="2026-09-27">
      <description>
        <ul>
          <li>The dial scale follows the "On air only" switch</li>
          <li>Traficom's allocation table and the KiwiSDR player are on by default</li>
          <li>View switches, filters and the dial zoom are saved the moment they change</li>
          <li>With rigctld started by otd, the host is fixed to this machine</li>
        </ul>
      </description>
    </release>
    <release version="1.6.0" date="2026-09-27">
      <description>
        <ul>
          <li>Hamlib's rigctld now comes with every download: the Linux AppImage and the macOS app carry it too, as the Windows packages and the Flatpak already did</li>
          <li>Settings no longer ask where rigctld is; the included copy is used, or the one on the PATH for a build from source</li>
        </ul>
      </description>
    </release>
    <release version="1.5.4" date="2026-09-27">
      <description>
        <ul>
          <li>Column widths are remembered across starts and saved right after a change; the delta column has room for its widest value</li>
          <li>The search box is a plain search again: numbers match the frequency, nothing moves the dial</li>
          <li>Typing a frequency while following the rig no longer switches to manual mode</li>
          <li>KiwiSDR player: an S-meter bar instead of a dBm figure</li>
          <li>Settings: sources shown with their web pages instead of editable addresses; the version check moved to the Data tab; Traficom replaces the built-in band plan when on</li>
        </ul>
      </description>
    </release>
    <release version="1.5.3" date="2026-09-27">
      <description>
        <ul>
          <li>Windows: an installer (otd-setup.exe) next to the portable zip, with a Start menu entry and an uninstaller; otd.exe carries its icon and version</li>
          <li>The dial scale opens at 100 kHz and remembers the zoom</li>
        </ul>
      </description>
    </release>
    <release version="1.5.2" date="2026-09-27">
      <description><p>The program announces the desktop entry it was installed with, so the icon shows in the Flatpak on Wayland; the Flatpak gets sound output for the KiwiSDR player.</p></description>
    </release>
    <release version="1.5.1" date="2026-09-27">
      <description><p>The arrow keys tune again while no rig is followed; 1.5.0 shipped that feature broken.</p></description>
    </release>
    <release version="1.5.0" date="2026-09-27">
      <description>
        <ul>
          <li>The program is now called otd; the web page moved to otd.oh2gba.eu</li>
          <li>Dial scale: a radio-style scale above the list with the stations at their frequencies; wheel to zoom, drag to look around, double-click to tune</li>
          <li>Listen online: a KiwiSDR player that follows the tuned frequency and mode, with the public receiver directory built in</li>
          <li>Traficom's Finnish frequency allocation table as an optional data source for a much finer band indicator</li>
          <li>Search: a number jumps to that frequency; arrow keys tune when no rig is followed</li>
          <li>The mouse wheel scrolls the dial view again; Escape or the next VFO move brings the tuned frequency back to the middle</li>
          <li>Settings on three tabs; light or dark colours with --palette; the icon shows on every platform</li>
        </ul>
      </description>
    </release>
    <release version="1.4.1" date="2026-09-22">
      <description><p>Search results keep their order when a result is tuned: sorted on air first, then by frequency, and the list is not reloaded while the VFO moves.</p></description>
    </release>
    <release version="1.4.0" date="2026-09-22">
      <description>
        <ul>
          <li>Search: every word must match ("bbc english"), a leading "!" excludes a word ("!china english"); country names are matched too</li>
          <li>Downloads show their progress and resume after a slow server drops the connection, so the Aoki list loads reliably</li>
          <li>Band indicator also names well known unlicensed uses: pirate and free radio bands, the 11 m freeband, ISM bands</li>
          <li>"On air only" no longer leaves the dial view blank</li>
        </ul>
      </description>
    </release>
    <release version="1.3.1" date="2026-09-22">
      <description><p>The version check runs once after start and every 24 hours while the program is running; the link to a newer version now sits above the clock.</p></description>
    </release>
    <release version="1.3.0" date="2026-09-22">
      <description>
        <ul>
          <li>Dial view refined: one continuous table, blank rows at the ends of the list so the tuned frequency always stays in the middle, no row selection, a short blink on the row sent to the radio</li>
          <li>Right-click on the column header to choose the columns, double-click to fit them to the data and the window</li>
          <li>Search returns every match; Escape clears the search; double-clicking a result keeps the search open</li>
        </ul>
      </description>
    </release>
    <release version="1.2.0" date="2026-09-22">
      <description>
        <ul>
          <li>Dial view: the tuned frequency stays in the middle of the list, lower frequencies above it and higher ones below, like a tuning scale</li>
          <li>Entries within the chosen ± kHz range are shown in red</li>
          <li>Column widths follow the window width</li>
        </ul>
      </description>
    </release>
    <release version="1.1.1" date="2026-09-22">
      <description><p>The version check now succeeds on hosts where IPv6 connections hang.</p></description>
    </release>
    <release version="1.1.0" date="2026-09-22">
      <description>
        <ul>
          <li>Optional daily check for a new version, shown as a small note in the status bar</li>
          <li>Any additional station list found in the database is shown alongside the downloaded ones</li>
          <li>Fixed a crash on exit</li>
        </ul>
      </description>
    </release>
    <release version="1.0.2" date="2026-09-20">
      <description><p>Builds cleanly against Qt 6.10 and newer.</p></description>
    </release>
    <release version="1.0.1" date="2026-09-20">
      <description>
        <ul>
          <li>Band plan indicator next to the frequency (broadcast, amateur, aeronautical, maritime, time signal bands) with an ITU region setting</li>
          <li>macOS build and Flatpak packaging</li>
        </ul>
      </description>
    </release>
    <release version="1.0.0" date="2026-09-20">
      <description><p>First release.</p></description>
    </release>
  </releases>
</component>
