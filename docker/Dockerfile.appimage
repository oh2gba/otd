# AppImage build environment for otd.
# Ubuntu 22.04 (glibc 2.35) keeps the result usable on most distributions
# from 2022 onwards; Qt 6.8 comes from the official binaries via aqtinstall.
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive LANG=C.UTF-8 LC_ALL=C.UTF-8
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential cmake ninja-build git ca-certificates wget file patchelf \
        python3 python3-pip zsync desktop-file-utils \
        libgl1-mesa-dev libegl1 libglib2.0-0 libfontconfig1 libfreetype6 libdbus-1-3 \
        libxkbcommon0 libxkbcommon-x11-0 libxcb1 libxcb-cursor0 libxcb-icccm4 libxcb-image0 \
        libxcb-keysyms1 libxcb-randr0 libxcb-render-util0 libxcb-shape0 libxcb-sync1 \
        libxcb-xfixes0 libxcb-xinerama0 libxcb-xkb1 libx11-xcb1 libwayland-client0 \
        libwayland-cursor0 libwayland-egl1 libsm6 libice6 libxrender1 libpulse0 \
    && rm -rf /var/lib/apt/lists/*

ARG QT_VERSION=6.8.3
RUN pip3 install --no-cache-dir aqtinstall \
    && aqt install-qt --outputdir /opt/qt linux desktop ${QT_VERSION} linux_gcc_64 \
         -m qtwebsockets qtmultimedia --archives qtbase qtwayland qtsvg icu qtwebsockets qtmultimedia \
    && rm -rf /root/.cache

RUN mkdir -p /opt/linuxdeploy && cd /opt/linuxdeploy \
    && wget -q https://github.com/linuxdeploy/linuxdeploy/releases/download/continuous/linuxdeploy-x86_64.AppImage \
    && wget -q https://github.com/linuxdeploy/linuxdeploy-plugin-qt/releases/download/continuous/linuxdeploy-plugin-qt-x86_64.AppImage \
    && chmod +x *.AppImage

ENV QT_VERSION=${QT_VERSION}
ENV QT_DIR=/opt/qt/${QT_VERSION}/gcc_64
# Only SQLite is used; the other SQL drivers would drag in client libraries.
RUN cd ${QT_DIR}/plugins/sqldrivers && ls | grep -v qsqlite | xargs -r rm -f \
    && cd ${QT_DIR}/lib/cmake/Qt6Sql && ls Qt6Q*DriverPlugin*.cmake | grep -v QSQLite | xargs -r rm -f
ENV PATH=/opt/linuxdeploy:${QT_DIR}/bin:${PATH}
ENV QMAKE=${QT_DIR}/bin/qmake
ENV APPIMAGE_EXTRACT_AND_RUN=1
WORKDIR /src
