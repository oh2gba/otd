# Cross-build environment for the Windows binary of otd.
# Debian's mingw-w64 GCC plus the official Qt 6 MinGW binaries fetched with
# aqtinstall (and the matching Linux host tools for moc/rcc/uic).
FROM debian:trixie-slim

ENV DEBIAN_FRONTEND=noninteractive LANG=C.UTF-8 LC_ALL=C.UTF-8
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential cmake ninja-build git ca-certificates zip \
        mingw-w64 g++-mingw-w64-x86-64-posix python3 python3-pip p7zip-full \
    && rm -rf /var/lib/apt/lists/*

ARG QT_VERSION=6.8.3
RUN pip3 install --break-system-packages --no-cache-dir aqtinstall \
    && aqt install-qt --outputdir /opt/qt windows desktop ${QT_VERSION} win64_mingw -m qtwebsockets qtmultimedia --archives qtbase qtwebsockets qtmultimedia \
    && aqt install-qt --outputdir /opt/qt linux desktop ${QT_VERSION} linux_gcc_64 --archives qtbase icu \
    && rm -rf /root/.cache

ENV QT_VERSION=${QT_VERSION}
ENV QT_TARGET=/opt/qt/${QT_VERSION}/mingw_64
ENV QT_HOST=/opt/qt/${QT_VERSION}/gcc_64

COPY mingw-toolchain.cmake /opt/mingw-toolchain.cmake
WORKDIR /src

# Runtime libraries needed by the Linux host tools (moc, rcc, uic).
RUN apt-get update && apt-get install -y --no-install-recommends \
        libglib2.0-0 libgl1 libfontconfig1 libxkbcommon0 libdbus-1-3 libfreetype6 \
    && rm -rf /var/lib/apt/lists/*
